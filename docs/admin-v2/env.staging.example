# Variables pour travailler sur le STAGING — copier vers .env.local (jamais commité : .env* est ignoré par Git).
# N'y mettez JAMAIS les clés de la production.
#
# Attention : le .env.local actuel contient les clés PayPal LIVE (argent réel) et la clé service de la
# production. L'admin-v2 n'utilise ni l'un ni l'autre, mais le reste du site (paiements) si : en local,
# gardez le staging + le bac à sable PayPal pour ne jamais déclencher de vrai paiement par erreur.

NEXT_PUBLIC_SUPABASE_URL=https://<ref-staging>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clé publique du staging>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<même clé publique, si l'ancien nom est encore lu>
SUPABASE_SECRET_KEY=<clé secrète du STAGING — serveur uniquement>

# PayPal : bac à sable (sandbox), pas le compte live
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=<client id sandbox>
PAYPAL_CLIENT_ID=<client id sandbox>
PAYPAL_SECRET=<secret sandbox>

# Développement local uniquement : désactiver l'obligation de MFA. Ignoré en production.
# ADMIN_V2_REQUIRE_MFA=false
